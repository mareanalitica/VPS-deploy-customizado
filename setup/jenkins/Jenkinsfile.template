pipeline {
    agent any

    environment {
        APP_NAME = 'api-nestjs'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        DEPLOY_ROOT = "${env.VPS_DEPLOY_ROOT ?: '/opt/vps-deploy'}"
    }

    stages {
        stage('1. Checkout Codigo') {
            steps {
                checkout scm
            }
        }

        stage('2. Gerar & Injetar Variaveis (.env)') {
            steps {
                script {
                    def envFile = "${DEPLOY_ROOT}/setup/env/apps/${APP_NAME}.env"
                    def envExample = "${DEPLOY_ROOT}/setup/env/apps/${APP_NAME}.env.example"
                    def setupScript = "${DEPLOY_ROOT}/setup/scripts/manage-env.js"

                    sh "node '${setupScript}' '${envFile}' '${envExample}'"
                    sh "cp '${envFile}' .env"
                }
            }
        }

        stage('3. Build da Imagem Docker') {
            steps {
                sh "docker build -t ${APP_NAME}:${IMAGE_TAG} -t ${APP_NAME}:latest ."
            }
        }

        stage('4. Deploy / Atualizacao no Swarm') {
            steps {
                sh """
                    docker service update --image ${APP_NAME}:${IMAGE_TAG} ${APP_NAME}_service || \
                    docker compose -f docker-compose.yml up -d --build
                """
            }
        }

        stage('5. Testes E2E (QA Pipeline)') {
            steps {
                script {
                    def qaDir = "${DEPLOY_ROOT}/apps/qa-test-automation-pipeline"
                    def exists = sh(script: "test -f '${qaDir}/package.json'", returnStatus: true) == 0
                    if (exists) {
                        sh "npm --prefix '${qaDir}' test || true"
                    }
                }
            }
        }
    }

    post {
        always {
            sh "docker image prune -f --filter 'until=24h'"
        }
        success {
            echo "Build e Deploy do ${APP_NAME} realizados com sucesso."
        }
        failure {
            echo "Erro durante o Build/Deploy do ${APP_NAME}."
        }
    }
}

# ==========================================
# CONFIGURAÇÕES DA API NESTJS
# ==========================================
PORT=3000
NODE_ENV=production

# Conexões com os serviços da VPS
MONGO_URI=mongodb://root:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/app_db?authSource=admin
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

POSTGRES_HOST=postvector
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=app_db

RABBITMQ_URL=amqp://admin:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672

# ==========================================
# CONFIGURACOES GERAIS DO CLIENTE
# ==========================================
CLIENT_NAME=cliente-demo
DOMAIN_NAME=cliente-demo.com
TRAEFIK_ACME_EMAIL=admin@cliente-demo.com

# ==========================================
# STACKS OPCIONAIS (alem da infra base)
# Default 0 = nao implanta - a maioria dos clientes nao precisa disso.
# ==========================================
DEPLOY_APPS_STACK=0
DEPLOY_EVOCRM_STACK=0
DEPLOY_EVOGO_STACK=0

# ==========================================
# PATH DO CHROMIUM PARA AUTOMATION & TESTES
# ==========================================
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ==========================================
# ACESSO AOS PAINEIS ADMINISTRATIVOS
# (Portainer, Jenkins, RabbitMQ management, console MinIO)
# ==========================================
# IP(s)/CIDR(s) autorizados a acessar os paineis, separados por virgula.
# O default (203.0.113.1/32) e' um IP de documentacao (RFC 5737) que nunca
# bate com trafego real - substitua pelo IP publico real do time ANTES do
# primeiro deploy em producao, ou os paineis ficarao inacessiveis (fail-closed).
ADMIN_ALLOWED_CIDRS=203.0.113.1/32

# ==========================================
# SERVICOS OPCIONAIS DA INFRA BASE
# ==========================================
# Defina como 0 pra nao subir um servico que este cliente ainda nao usa
# (economiza RAM numa VPS menor). Default 1 = comportamento de sempre.
MONGO_REPLICAS=1
MINIO_REPLICAS=1
N8N_REPLICAS=1
CHROMIUM_REPLICAS=1

# ==========================================
# VERSOES DAS IMAGENS DOCKER
# (Altere aqui para pinar ou atualizar versoes)
# ==========================================
TRAEFIK_IMAGE=traefik:v3.6
PORTAINER_IMAGE=portainer/portainer-ce:lts
JENKINS_IMAGE=jenkins/jenkins:lts-jdk17
MONGO_IMAGE=mongo:7
REDIS_IMAGE=redis:7-alpine
POSTVECTOR_IMAGE=pgvector/pgvector:pg16
RABBITMQ_IMAGE=rabbitmq:3-management-alpine
MINIO_IMAGE=minio/minio:latest
N8N_IMAGE=n8nio/n8n:1
CHROMIUM_IMAGE=zenika/alpine-chrome:latest

# ==========================================
# CREDENCIAIS DOS SERVICOS INFRAESTRUTURA
# (Geradas automaticamente pelo setup se vazias)
# ==========================================

# 1. MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=27017

# 2. Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# 3. Postvector (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# 4. RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 5. MinIO (S3 Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 6. Jenkins (CI/CD)
JENKINS_PORT=8080
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=

# 7. n8n (Workflow Automation)
N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# 8. Portainer
PORTAINER_PORT=9002

# ==========================================
# ISOLAMENTO POR APP DENTRO DO POSTGRES/RABBITMQ COMPARTILHADOS
# (bancos/roles/vhost proprios por app - nunca a role/usuario admin)
# Ver setup/scripts/bootstrap-app-databases.sh
# ==========================================
API_NESTJS_DB_PASSWORD=
API_NESTJS_RABBITMQ_PASSWORD=

EVOCRM_DB_PASSWORD=
EVOGO_DB_PASSWORD=

# Reservado - api-nestjs-payment-service ainda nao tem codigo implementado,
# so o banco/role ja ficam preparados.
PAYMENT_DB_PASSWORD=

# ==========================================
# EVOCRM (Evo AI CRM Community)
# ==========================================
CRM_WEB_DOMAIN=crm.cliente-demo.com
CRM_API_DOMAIN=crmapi.cliente-demo.com
CRM_SECRET_KEY_BASE=
CRM_JWT_SECRET_KEY=
CRM_DOORKEEPER_JWT_SECRET_KEY=
CRM_ENCRYPTION_KEY=
CRM_EVOAI_CRM_API_TOKEN=
CRM_BOT_RUNTIME_SECRET=
# SMTP (opcional - deixe em branco pra desabilitar envio de email)
CRM_SMTP_HOST=
CRM_SMTP_PORT=587
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=
CRM_SMTP_FROM=noreply@cliente-demo.com

# ==========================================
# EVOGO (Evolution Go - gateway WhatsApp)
# ==========================================
EVOGO_DOMAIN=evogo.cliente-demo.com
EVOGO_GLOBAL_API_KEY=
